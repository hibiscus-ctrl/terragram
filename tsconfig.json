{
  // The tests and the release gates in scripts/ (validate-emit, check-module-inputs,
  // gen-schemas), which no package's tsconfig includes. `npm run typecheck:all` runs
  // this one beside the engine, the CLI and the Action.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The dependency-CVE gate is plain JavaScript, imported by its test.
    "allowJs": true,
    // Tests index into known-shaped fixtures (arr[0], .find()!) and assert on the
    // result; a wrong index just fails the test. Relaxing here keeps the type gate
    // focused on real drift (renamed exports, changed signatures) without forcing
    // non-null guards through every fixture access. The scripts index into fixtures
    // they built themselves, for the same reason.
    "noUncheckedIndexedAccess": false
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
