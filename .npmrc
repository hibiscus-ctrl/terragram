legacy-peer-deps=true

# @infraweaver-io/* lives on GitHub Packages (restricted scope), not npmjs.
# Auth is NOT committed: locally it comes from ~/.npmrc (classic PAT with
# read:packages); in CI from setup-node's registry-url + NODE_AUTH_TOKEN;
# in the Railway image build from a BuildKit secret. Same as infraweaver-ui.
@infraweaver-io:registry=https://npm.pkg.github.com
