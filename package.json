{
  "name": "terragram-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "action"
  ],
  "scripts": {
    "build:packages": "npm run build -w terragram-engine -w terragram",
    "build:action": "npm run build -w terragram-action",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:engine": "tsc -p packages/engine --noEmit",
    "typecheck:cli": "tsc -p packages/cli --noEmit",
    "typecheck:action": "tsc -p action --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:engine && npm run typecheck:cli && npm run typecheck:action",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write .",
    "lint:ox": "oxlint",
    "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity --validate-package-names",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:packages": "node --test tests/schemas.test.ts tests/cli.test.ts tests/cli-bundle.test.ts",
    "test:coverage": "c8 --all --src packages/engine/src --src packages/cli/src --include \"packages/engine/src/**\" --include \"packages/cli/src/**\" --exclude packages/cli/src/main.ts --check-coverage --lines 98 --statements 98 --branches 88 --functions 99 --reporter text --reporter text-summary node --test \"tests/**/*.test.ts\"",
    "validate:emit": "node scripts/validate-emit.ts",
    "schemas:gen": "node scripts/gen-schemas.ts",
    "schemas:check": "node scripts/gen-schemas.ts --check",
    "refresh:providers": "node scripts/refresh-providers.mjs && npm run check:modules",
    "check:modules": "node scripts/check-module-inputs.ts",
    "check:imports": "depcruise packages/engine/src packages/cli/src action/src --output-type err-long && node scripts/check-engine-env.mjs",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cdktf/hcl2json": "^0.21.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "^12.0.0",
    "dependency-cruiser": "^18.8.0",
    "esbuild": "^0.28.2",
    "infraweaver": "^0.3.14",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "lockfile-lint": "^5.1.0",
    "oxlint": "^1.94.0",
    "terragram-engine": "*",
    "typescript": "7.0.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
