{
  "name": "terragram-ui",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:e2e": "tsc -p cypress/tsconfig.json --noEmit",
    "typecheck:all": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p cypress/tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write .",
    "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm npm.pkg.github.com --validate-https --validate-integrity --validate-package-names",
    "test": "node --import ./scripts/register-alias.mjs --test \"tests/**/*.test.ts\"",
    "test:api": "start-server-and-test test:api:server http://localhost:3100/api/health test:api:run",
    "test:api:server": "env-cmd -f ./.env.test next dev -p 3100",
    "test:api:run": "env-cmd -f ./.env.test node --import ./scripts/register-alias.mjs --test \"tests/api/**/*.test.ts\"",
    "test:api:unconfigured": "start-server-and-test test:api:unconfigured:server http://localhost:3101/api/health test:api:unconfigured:run",
    "test:api:unconfigured:server": "env-cmd -f ./.env.test.unconfigured next dev -p 3101",
    "test:api:unconfigured:run": "env-cmd -f ./.env.test.unconfigured node --import ./scripts/register-alias.mjs --test \"tests/api-unconfigured/**/*.test.ts\"",
    "test:api:all": "npm run test:api && npm run test:api:unconfigured",
    "test:rls": "env-cmd -f ./.env.local node --use-system-ca --import ./scripts/register-alias.mjs --test tests/rls-runtime.test.ts",
    "e2e": "env-cmd -f ./.env.local cypress run",
    "e2e:open": "env-cmd -f ./.env.local cypress open",
    "e2e:ci": "start-server-and-test start http://localhost:3000/api/health/ready e2e",
    "links": "start-server-and-test start http://localhost:3000/api/health/ready links:run",
    "links:run": "linkinator http://localhost:3000 --recurse --timeout 20000 --concurrency 20 --skip \"mailto:|^https://(www\\.)?linkedin\\.com|^https://x\\.com\"",
    "test:cloud": "node --import ./scripts/register-alias.mjs scripts/selftest-cloud.ts",
    "validate:emit": "node scripts/validate-emit.ts",
    "db:types": "env-cmd -f ./.env.local node scripts/supabase-cli.mjs gen-types",
    "db:link": "env-cmd -f ./.env.local node scripts/supabase-cli.mjs link",
    "db:migrate": "env-cmd -f ./.env.local node scripts/supabase-cli.mjs migrate",
    "db:exec": "env-cmd -f ./.env.local node --use-system-ca scripts/db-exec.mjs",
    "db:apply": "npm run db:apply:sql && npm run db:drift && npm run db:types",
    "db:apply:sql": "env-cmd -f ./.env.local node --use-system-ca scripts/db-exec.mjs ./supabase/migrations/20240101000000_database.sql",
    "db:drift": "env-cmd -f ./.env.local node --use-system-ca scripts/db-drift.mjs",
    "db:reset": "env-cmd -f ./.env.local node --use-system-ca scripts/db-reset.mjs",
    "cron:schedule": "env-cmd --no-override -f ./.env.local node --use-system-ca scripts/schedule-cron.mjs",
    "db:seed-owner": "env-cmd -f ./.env.local node --use-system-ca scripts/db-seed-owner.mjs",
    "dogfood:metrics": "env-cmd -f ./.env.local node --use-system-ca scripts/dogfood-metrics.mjs",
    "refresh:providers": "node scripts/refresh-providers.mjs && npm run check:modules",
    "check:modules": "node scripts/check-module-inputs.ts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:colours": "node scripts/check-colour-tokens.mjs",
    "check:design-doc": "node scripts/check-design-doc.mjs",
    "check:design": "npm run check:contrast && npm run check:colours && npm run check:design-doc",
    "check:imports": "depcruise src --output-type err-long",
    "knip": "knip",
    "stripe:setup": "env-cmd -f ./.env.local node --use-system-ca scripts/stripe-setup.mjs",
    "db:verify-auth": "env-cmd -f ./.env.local node --use-system-ca scripts/verify-auth.mjs",
    "db:test-user": "env-cmd -f ./.env.local node --use-system-ca scripts/create-test-user.mjs",
    "instance:create": "env-cmd -f ./.env.local node --use-system-ca scripts/instance-create.mjs",
    "stripe:listen": "stripe listen --forward-to=localhost:3000/api/webhooks --project-name=terragram",
    "lint:ox": "oxlint",
    "test:coverage": "c8 --all --src src --include \"src/features/workspace/**\" --include \"src/features/billing/**\" --include \"src/features/git/**\" --include \"src/libs/rate-limit.ts\" --include \"src/utils/csp.ts\" --include \"src/utils/zip.ts\" --exclude \"src/features/*/actions.ts\" --exclude \"src/features/*/store.ts\" --exclude \"src/features/billing/actions/**\" --exclude \"src/features/workspace/identity.ts\" --exclude \"src/features/billing/{managed-usage,metering,org-plan,seat-sync,seats,stripe-billing,stripe-catalog}.ts\" --check-coverage --lines 96 --statements 96 --branches 85 --functions 90 --reporter text --reporter text-summary node --import ./scripts/register-alias.mjs --test \"tests/**/*.test.ts\"",
    "test:components": "tsx --experimental-test-module-mocks --test \"tests/component/*.test.tsx\""
  },
  "dependencies": {
    "@infraweaver-io/attest": "^0.1.7",
    "@infraweaver-io/core": "^0.1.5",
    "@infraweaver-io/sandbox": "^0.1.8",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cdktf/hcl2json": "^0.21.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@swc/core": "^1.16.22",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "cypress": "^16.3.0",
    "dependency-cruiser": "^18.8.0",
    "env-cmd": "^11.0.0",
    "infraweaver": "^0.3.14",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "lockfile-lint": "^5.1.0",
    "linkinator": "^8.1.0",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.33",
    "start-server-and-test": "^3.0.12",
    "supabase": "^2.122.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
