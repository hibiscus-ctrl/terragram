{
  // The Action on its own terms: Node only, no DOM, and nothing but the engine's public
  // exports (`terragram-engine/<subpath>`), exactly as a host outside this repo sees them.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext"],
    "jsx": "preserve",
    "plugins": [],
    "paths": {},
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
