{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // The release gates (validate-emit, check-module-inputs) and the self-test are
    // typechecked by nothing else: the app tsconfig excludes scripts/ and the tests
    // one includes only tests/. Same relaxation as tests, for the same reason — the
    // self-test indexes into fixtures it built itself.
    "noUncheckedIndexedAccess": false
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
