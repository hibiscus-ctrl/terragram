{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hibiscus-ctrl/terragram/schemas/model.v1.schema.json",
  "title": "Diagram model (diagram.model/v1)",
  "description": "An infrastructure diagram as the engine reads it: components (nodes, at most 300) and the connections between them (edges, at most 600), optionally with the cloud it targets. A bare model, as found in an evidence bundle's model.json, is valid.",
  "type": "object",
  "properties": {
    "nodes": {
      "maxItems": 300,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "category": {
            "type": "string",
            "enum": [
              "compute",
              "network",
              "storage",
              "identity",
              "observability",
              "edge"
            ]
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "maxLength": 160
          },
          "flag": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "maxLength": 400
                  }
                },
                "required": [
                  "reason"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "attributes": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 40
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 120
            }
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "selfAccess": {
            "description": "Set when the node's own grants reach the node itself, so it can widen its own access (a role whose policy may rewrite the role, a service account that may mint tokens for itself): admin, or unscoped when the grant could not be read closely. Absent otherwise. Counts as admin access.",
            "type": "string",
            "enum": [
              "admin",
              "unscoped"
            ]
          },
          "selfConditional": {
            "description": "With selfAccess: every grant behind it carries a condition. The level is the same.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "category",
          "kind",
          "label"
        ]
      }
    },
    "edges": {
      "maxItems": 600,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "origin": {
            "default": "derived",
            "type": "string",
            "enum": [
              "derived",
              "user"
            ]
          },
          "access": {
            "type": "string",
            "enum": [
              "runs-as",
              "read",
              "write",
              "admin",
              "unscoped"
            ]
          },
          "conditional": {
            "type": "boolean"
          },
          "unconditional": {
            "type": "string",
            "enum": [
              "runs-as",
              "read",
              "write",
              "admin",
              "unscoped"
            ]
          }
        },
        "required": [
          "id",
          "source",
          "target"
        ]
      }
    },
    "topology": {
      "default": "derived",
      "type": "string",
      "enum": [
        "derived",
        "manual"
      ]
    },
    "schema": {
      "type": "string",
      "const": "diagram.model/v1"
    },
    "cloud": {
      "type": "string",
      "enum": [
        "azure",
        "aws",
        "gcp"
      ],
      "description": "The cloud the document describes. `gcp` is read only: such a model is drawn and explained, no Terraform is generated for it and its receipt has an empty plan. A reader that validates this field against a closed list must accept `gcp`; documents for `azure` and `aws` are unchanged."
    }
  },
  "required": [
    "nodes",
    "edges"
  ]
}
