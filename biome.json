{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "packages/**/*.{ts,mts,mjs,js}",
      "action/**/*.{ts,mts,mjs,js}",
      "!action/dist",
      "scripts/**/*.{ts,mts,mjs,js}",
      "tests/**/*.{ts,mts,mjs,js}",
      "*.{ts,js,mjs,cjs}"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noCommentText": "off",
        "noTemplateCurlyInString": "off"
      },
      "nursery": {
        "noExtendNative": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ],
  "formatter": { "enabled": false },
  "assist": { "enabled": false }
}
