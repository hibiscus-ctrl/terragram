{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "next": true,
      "entry": [
        "tests/**/*.test.{ts,tsx}",
        "scripts/*.{ts,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "*.{ts,js,mjs,cjs}"
      ],
      "ignore": [
        "src/libs/supabase/types.ts"
      ],
      "ignoreDependencies": [
        "@swc/core",
        "@cdktf/hcl2json",
        "infraweaver",
        "postcss-load-config"
      ],
      "ignoreBinaries": [
        "stripe",
        "terraform"
      ]
    },
    "packages/engine": {
      "entry": [
        "src/*.ts",
        "build.mjs",
        "rewrite-declarations.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "*.mjs"
      ],
      "includeEntryExports": true
    },
    "packages/cli": {
      "entry": [
        "src/main.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "action": {
      "entry": [
        "src/main.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.mjs"
      ]
    }
  },
  "exclude": [
    "nsExports",
    "nsTypes",
    "enumMembers",
    "duplicates"
  ]
}
