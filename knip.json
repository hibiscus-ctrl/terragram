{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tests/**/*.test.ts",
        "scripts/*.{ts,mjs}"
      ],
      "project": [
        "tests/**/*.ts",
        "scripts/**/*.{ts,mjs}"
      ],
      "ignoreDependencies": [
        "@swc/core",
        "@cdktf/hcl2json",
        "infraweaver"
      ],
      "ignoreBinaries": [
        "terraform"
      ]
    },
    "packages/engine": {
      "entry": [
        "src/*.ts",
        "build.mjs",
        "rewrite-declarations.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "*.mjs"
      ],
      "includeEntryExports": true
    },
    "packages/cli": {
      "entry": [
        "src/main.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "action": {
      "entry": [
        "src/main.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.mjs"
      ]
    }
  },
  "exclude": [
    "nsExports",
    "nsTypes",
    "enumMembers",
    "duplicates"
  ]
}
